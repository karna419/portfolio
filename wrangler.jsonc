// Cloudflare Worker config. Workers Builds runs `npm ci`, then `npx wrangler deploy` (which builds first).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "portofolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Cloudflare's own build command is empty, so wrangler builds the site before deploying.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve dist/404.html for unknown pages.
    "not_found_handling": "404-page",
    // Static files skip the Worker entirely; only the booking API runs code.
    "run_worker_first": ["/api/*"]
  },
  // CAL_API_KEY (Secret) and CAL_USERNAME are set in the dashboard under
  // Settings → Variables and Secrets, as are the optional TURNSTILE_SITE_KEY and
  // TURNSTILE_SECRET_KEY (Secret). keep_vars stops deploys from wiping them.
  "keep_vars": true,
  // Rate limits for the booking API, counted per visitor IP (and per email for bookings) at
  // each Cloudflare location. No secret needed. namespace_id is any number unique in the account.
  "ratelimits": [
    { "name": "BOOK_LIMITER", "namespace_id": "4190", "simple": { "limit": 3, "period": 60 } },
    { "name": "SLOTS_LIMITER", "namespace_id": "4191", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
