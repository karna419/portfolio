// Cloudflare Worker config. Workers Builds runs `npm ci`, then `npx wrangler deploy` (which builds first).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "portofolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Cloudflare's own build command is empty, so wrangler builds the site before deploying.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve dist/404.html for unknown pages.
    "not_found_handling": "404-page",
    // Static files skip the Worker entirely; only the booking API runs code.
    "run_worker_first": ["/api/*"]
  },
  // CAL_API_KEY (Secret) and CAL_USERNAME are set in the dashboard under
  // Settings → Variables and Secrets. keep_vars stops deploys from wiping them.
  "keep_vars": true,
  "observability": { "enabled": true }
}
