---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getWork } from '../../lib';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const involvement = { 'end-to-end': 'Sole developer', contributor: 'Contributor' };
---
<Base title={d.title} description={d.summary}>
  <article class="mx-auto max-w-6xl px-4 sm:px-8 pt-6 sm:pt-10 pb-10">
    <div class="glass rounded-[2.25rem] px-6 sm:px-12 py-10 sm:py-14">
    <a href="/#work" class="link text-sm">Back to all work</a>
    {d.icon && <img src={d.icon} alt={`${d.title} app icon`} width="96" height="96" class="work-hero-icon mt-8 size-24 rounded-[23%] shadow-[0_12px_26px_-10px_rgb(10_16_40/0.55)]" />}
    <h1 class="mt-6 font-bold tracking-[-0.035em] text-[clamp(2.5rem,7vw,5rem)] max-w-[20ch]">{d.title}</h1>
    <p class="mt-5 text-xl sm:text-2xl leading-snug max-w-[44ch] text-balance">{d.summary}</p>

    <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-6 border-y border-rule py-6 text-[0.95rem]">
      <div><dt class="text-muted">Year</dt><dd class="tabular-nums">{d.year}</dd></div>
      {d.involvement && <div><dt class="text-muted">Involvement</dt><dd>{involvement[d.involvement]}</dd></div>}
      {d.role && <div><dt class="text-muted">Role</dt><dd>{d.role}</dd></div>}
      {d.stack.length > 0 && <div><dt class="text-muted">Built with</dt><dd>{d.stack.join(', ')}</dd></div>}
      {(d.url || d.repo || d.appStore || d.playStore) && (
        <div>
          <dt class="text-muted">Links</dt>
          <dd class="flex flex-wrap gap-x-4">
            {d.appStore && <a class="link inline-flex items-center gap-1.5" href={d.appStore}><Icon name="apple" class="size-4" />App Store</a>}
            {d.playStore && <a class="link inline-flex items-center gap-1.5" href={d.playStore}><Icon name="googleplay" class="size-4" />Google Play</a>}
            {d.url && <a class="link" href={d.url}>Live site</a>}
            {d.repo && <a class="link" href={d.repo}>Code</a>}
          </dd>
        </div>
      )}
    </dl>

    <div class="prose-work mt-12">
      <Content />
    </div>
    </div>
  </article>
</Base>
