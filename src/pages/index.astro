---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { getWork } from '../lib';
import Icon from '../components/Icon.astro';
import Booker from '../components/Booker.astro';

const work = await getWork();
const hire = site.links.filter((l) => site.hire.includes(l.label));
---
<Base>
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-20 sm:pt-32 pb-16">
    <!-- Sized against the column width (cqi) so the name always spans it exactly. -->
    <div class="@container">
    <h1 class="font-display font-bold tracking-[-0.045em] leading-[0.9] text-[16.8cqi] whitespace-nowrap">
      {site.name}
    </h1>
    </div>
    <div class="name-bar mt-4 h-3 sm:h-4 w-full bg-marigold rounded-full" aria-hidden="true"></div>

    <p class="mt-10 max-w-[34rem] text-xl sm:text-2xl leading-snug text-balance">{site.intro}</p>

    <ul class="mt-8 flex flex-wrap items-center gap-3">
      {site.email && (
        <li>
          <a href={`mailto:${site.email}`} aria-label="Email" title="Email"
             class="grid place-items-center size-11 rounded-full border border-rule text-ink/85 hover:text-night hover:bg-marigold hover:border-marigold transition-colors">
            <Icon name="mail" class="size-5" />
          </a>
        </li>
      )}
      {site.links.map((l) => (
        <li>
          <a href={l.href} rel="me" aria-label={l.label} title={l.label}
             class="grid place-items-center size-11 rounded-full border border-rule text-ink/85 hover:text-night hover:bg-marigold hover:border-marigold transition-colors">
            <Icon name={l.icon} class="size-5" />
          </a>
        </li>
      ))}
      {site.cv && <li class="ml-2"><a class="link" href={site.cv}>CV (PDF)</a></li>}
    </ul>

    {site.location && (
      <p class="mt-6 flex items-center gap-1.5 text-muted">
        <Icon name="pin" class="size-[1.1rem]" />
        {site.location}
      </p>
    )}
  </section>

  <section id="work" class="mx-auto max-w-6xl px-5 sm:px-8 py-16 scroll-mt-8">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Selected work</h2>

    {work.length === 0 ? (
      <p class="mt-8 max-w-[60ch] text-muted">
        Project write-ups are on the way. In the meantime, my code is on{' '}
        <a class="link text-ink" href="https://github.com/karna419">GitHub</a>.
      </p>
    ) : (
      <ul class="mt-8 border-t border-rule">
        {work.map((p) => (
          <li class="border-b border-rule">
            <a
              href={`/work/${p.id}/`}
              class="group grid grid-cols-[auto_minmax(0,1fr)] gap-x-5 sm:gap-x-8 gap-y-1 py-6 sm:grid-cols-[5rem_minmax(0,1fr)_minmax(0,16rem)] items-baseline"
            >
              <span class="text-muted tabular-nums col-span-2 sm:col-span-1">{p.data.year}</span>
              <span class="col-span-2 sm:col-span-1 flex gap-4 items-start">
                {p.data.icon && (
                  <img src={p.data.icon} alt="" width="56" height="56" loading="lazy" class="size-14 shrink-0 rounded-[22%] border border-rule" />
                )}
                <span>
                <span class="font-display text-2xl font-semibold tracking-tight underline decoration-transparent decoration-2 underline-offset-4 group-hover:decoration-marigold transition-colors">
                  {p.data.title}
                </span>
                {p.data.draft && <span class="ml-2 text-sm text-marigold-deep">(draft — hidden on the live site)</span>}
                <span class="block mt-1 text-muted max-w-[60ch]">{p.data.summary}</span>
                </span>
              </span>
              <span class="col-span-2 sm:col-span-1 text-sm text-muted sm:text-right">{p.data.stack.join(', ')}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="contact" class="mx-auto max-w-6xl px-5 sm:px-8 py-16 scroll-mt-8">
    <div class="rounded-2xl bg-night text-snow dark:ring-1 dark:ring-rule px-6 sm:px-12 py-12 sm:py-16">
      <h2 class="text-3xl sm:text-5xl font-semibold tracking-tight max-w-[18ch]">Have something you want built?</h2>
      <p class="mt-4 max-w-[55ch] text-snow/75">Tell me what you're working on. I usually reply within a couple of days.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {site.email && (
          <a href={`mailto:${site.email}`} class="inline-block rounded-full bg-marigold text-night font-semibold px-6 py-3 hover:bg-snow transition-colors">Email me</a>
        )}
        {hire.map((l) => (
          <a href={l.href} class="inline-flex items-center gap-2 rounded-full border border-snow/30 px-5 py-3 font-semibold hover:bg-snow hover:text-night transition-colors">
            <Icon name={l.icon} class="size-4" />
            Hire me on {l.label}
          </a>
        ))}
      </div>
      {site.email && <p class="mt-5 text-sm text-snow/60">{site.email}</p>}
      <Booker />
    </div>
  </section>
</Base>
