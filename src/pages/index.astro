---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { getWork } from '../lib';

const work = await getWork();
---
<Base>
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-20 sm:pt-32 pb-16">
    <!-- Sized against the column width (cqi) so the name always spans it exactly. -->
    <div class="@container">
    <h1 class="font-display font-bold tracking-[-0.045em] leading-[0.9] text-[16.8cqi] whitespace-nowrap">
      {site.name}
    </h1>
    </div>
    <div class="name-bar mt-4 h-3 sm:h-4 w-full bg-marigold rounded-full" aria-hidden="true"></div>

    <div class="mt-10 grid gap-8 sm:grid-cols-[minmax(0,34rem)_1fr] items-end">
      <p class="text-xl sm:text-2xl leading-snug text-balance">{site.intro}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 sm:justify-end">
        {site.email && <li><a class="link" href={`mailto:${site.email}`}>Email</a></li>}
        {site.links.map((l) => <li><a class="link" href={l.href} rel="me">{l.label}</a></li>)}
        {site.cv && <li><a class="link" href={site.cv}>CV (PDF)</a></li>}
      </ul>
    </div>
    {site.location && <p class="mt-6 text-muted">Based in {site.location}</p>}
  </section>

  <section id="work" class="mx-auto max-w-6xl px-5 sm:px-8 py-16 scroll-mt-8">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Selected work</h2>

    {work.length === 0 ? (
      <p class="mt-8 max-w-[60ch] text-muted">
        Project write-ups are on the way. In the meantime, my code is on
        <a class="link text-ink" href="https://github.com/karna419">GitHub</a>.
      </p>
    ) : (
      <ul class="mt-8 border-t border-rule">
        {work.map((p) => (
          <li class="border-b border-rule">
            <a
              href={`/work/${p.id}/`}
              class="group grid gap-x-8 gap-y-1 py-6 sm:grid-cols-[5rem_minmax(0,1fr)_minmax(0,16rem)] items-baseline"
            >
              <span class="text-muted tabular-nums">{p.data.year}</span>
              <span>
                <span class="font-display text-2xl font-semibold tracking-tight underline decoration-transparent decoration-2 underline-offset-4 group-hover:decoration-marigold transition-colors">
                  {p.data.title}
                </span>
                {p.data.draft && <span class="ml-2 text-sm text-marigold-deep">(draft — hidden on the live site)</span>}
                <span class="block mt-1 text-muted max-w-[60ch]">{p.data.summary}</span>
              </span>
              <span class="text-sm text-muted sm:text-right">{p.data.stack.join(', ')}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="contact" class="mx-auto max-w-6xl px-5 sm:px-8 py-16 scroll-mt-8">
    <div class="rounded-2xl bg-ink text-paper px-6 sm:px-12 py-12 sm:py-16">
      <h2 class="text-3xl sm:text-5xl font-semibold tracking-tight max-w-[18ch]">Have something you want built?</h2>
      <p class="mt-4 max-w-[55ch] text-paper/75">Tell me what you're working on. I usually reply within a couple of days.</p>
      <div class="mt-8 flex flex-wrap gap-4">
        {site.email ? (
          <a href={`mailto:${site.email}`} class="inline-block rounded-full bg-marigold text-ink font-semibold px-6 py-3 hover:bg-paper transition-colors">Email {site.email}</a>
        ) : (
          <a href="https://github.com/karna419" class="inline-block rounded-full bg-marigold text-ink font-semibold px-6 py-3 hover:bg-paper transition-colors">Find me on GitHub</a>
        )}
      </div>
    </div>
  </section>
</Base>
