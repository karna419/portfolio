---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { getWork } from '../lib';
import Icon from '../components/Icon.astro';
import Booker from '../components/Booker.astro';
import Phone from '../components/Phone.astro';
import Activity from '../components/Activity.astro';
import { activity } from '../data/activity';

const work = await getWork();
const hire = site.links.filter((l) => site.hire.includes(l.label));
// Off unless switched on in site.ts. While its data is made up, it is for the dev server only.
const showActivity = site.showActivity && (!activity.demo || import.meta.env.DEV);
---
<Base>
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-8 sm:pt-14 pb-12">
    <div class="grid items-center gap-x-12 gap-y-12 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
      <div>
        {site.available && (
          <a href="#contact" class="glass capsule mb-8 inline-flex items-center gap-2.5 px-4 h-9 text-sm font-medium">
            <span class="relative flex size-2.5" aria-hidden="true">
              <span class="absolute inline-flex size-full rounded-full bg-go opacity-60 animate-ping motion-reduce:hidden"></span>
              <span class="relative inline-flex size-2.5 rounded-full bg-go"></span>
            </span>
            Available
          </a>
        )}
        <!-- Sized against the column width (cqi) so the name always spans it exactly. -->
        <div class="@container">
          <h1 class="name-sheen font-display font-bold tracking-[-0.045em] leading-[0.95] text-[16.6cqi] whitespace-nowrap">
            {site.name}
          </h1>
        </div>

        {site.role && <p class="mt-6 text-lg sm:text-xl font-semibold text-tint">{site.role}</p>}
        <p class={`${site.role ? 'mt-2' : 'mt-7'} max-w-[30rem] text-xl sm:text-2xl leading-snug text-balance`}>{site.intro}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#work" class="btn btn-tint">See my work</a>
          {site.cv && <a class="link ml-2" href={site.cv}>CV (PDF)</a>}
        </div>
      </div>

      <Phone />
    </div>
  </section>

  <section id="work" class="mx-auto max-w-6xl px-5 sm:px-8 py-12 scroll-mt-20">
    <h2 class="text-3xl sm:text-4xl font-bold">Selected work</h2>

    {work.length === 0 ? (
      <p class="glass pane mt-6 p-6 max-w-[60ch] text-muted">
        Project write-ups are on the way. In the meantime, my code is on{' '}
        <a class="link text-ink" href="https://github.com/karna419">GitHub</a>.
      </p>
    ) : (
      <ul class="glass pane mt-6 overflow-hidden divide-y divide-rule">
        {work.map((p) => (
          <li>
            <a href={`/work/${p.id}/`} class="row flex items-center gap-4 sm:gap-5 px-4 sm:px-6 py-4 sm:py-5">
              {p.data.icon ? (
                <img src={p.data.icon} alt="" width="60" height="60" loading="lazy" class="size-[3.75rem] shrink-0 rounded-[23%] shadow-[0_8px_18px_-8px_rgb(10_16_40/0.5)]" />
              ) : (
                <span class="size-[3.75rem] shrink-0 rounded-[23%] border border-dashed border-rule" aria-hidden="true"></span>
              )}
              <span class="min-w-0 flex-1">
                <span class="font-display text-xl sm:text-[1.35rem] font-semibold tracking-tight">{p.data.title}</span>
                {p.data.draft && <span class="ml-2 text-sm text-tint-deep">(draft, hidden on the live site)</span>}
                <span class="block mt-0.5 text-muted text-[0.97rem] leading-snug max-w-[62ch]">{p.data.summary}</span>
              </span>
              <span class="hidden md:block shrink-0 text-right text-sm text-muted leading-snug">
                <span class="block">{p.data.stack.join(', ')}</span>
                <span class="block tabular-nums">{p.data.year}</span>
              </span>
              <svg class="size-4 shrink-0 text-muted/70" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
            </a>
          </li>
        ))}
      </ul>
    )}

    {showActivity && <Activity />}
  </section>

  {site.services.length > 0 && (
    <section id="services" class="mx-auto max-w-6xl px-5 sm:px-8 py-12 scroll-mt-20">
      <h2 class="text-3xl sm:text-4xl font-bold">What I do</h2>
      <ul class="mt-6 grid gap-5 sm:grid-cols-2">
        {site.services.map((s) => (
          <li class="glass pane p-6 sm:p-7">
            <h3 class="text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-muted leading-relaxed">{s.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section id="about" class="mx-auto max-w-6xl px-5 sm:px-8 py-12 scroll-mt-20">
    <h2 class="text-3xl sm:text-4xl font-bold">About me</h2>

    <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] items-start">
      <div class="glass pane p-6 sm:p-9 space-y-5 text-lg leading-relaxed">
        {site.about.map((para) => <p>{para}</p>)}
        {site.available && (
          <p>
            I have time for new work right now. If you have an app to build or overhaul, or work
            you want automated, <a class="link" href="#contact">write to me</a>.
          </p>
        )}
      </div>

      <dl class="glass pane overflow-hidden divide-y divide-rule">
        {site.stack.map((row) => (
          <div class="flex items-baseline justify-between gap-6 px-5 sm:px-6 py-3.5">
            <dt class="font-medium shrink-0">{row.group}</dt>
            <dd class="text-muted text-right">{row.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-6xl px-5 sm:px-8 py-12 scroll-mt-20">
    <div class="glass glass-dark rounded-[2.25rem] text-snow px-6 sm:px-12 py-12 sm:py-16">
      <h2 class="text-3xl sm:text-5xl font-bold max-w-[18ch]">Have something you want built?</h2>
      <p class="mt-4 max-w-[55ch] text-snow/75">{site.available && "I'm free to start now. "}Tell me what you're working on. I usually reply within a couple of days.</p>
      <div class="actions mt-8 flex flex-wrap gap-3">
        <!-- Shown by Booker.astro once the booking API answers. Opens the booking sheet. -->
        <button type="button" data-book-open hidden class="btn btn-tint cursor-pointer">
          <svg class="size-[1.05rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
          Book a call
        </button>
        {site.email && (
          <a href={`mailto:${site.email}`} class="btn btn-tint email-btn">Email me</a>
        )}
        {hire.map((l) => (
          <a href={l.href} class="btn btn-quiet">
            <Icon name={l.icon} class="size-4" />
            Hire me on {l.label}
          </a>
        ))}
      </div>
      {site.email && <p class="mt-5 text-sm text-snow/60">{site.email}</p>}
    </div>
    <Booker />
  </section>
</Base>

<script>
  // The glow inside the name follows the pointer (see .name-sheen in global.css).
  const name = document.querySelector<HTMLElement>('.name-sheen');
  if (name && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    name.addEventListener('pointermove', (e) => {
      const r = name.getBoundingClientRect();
      name.style.setProperty('--x', `${e.clientX - r.left}px`);
      name.style.setProperty('--y', `${e.clientY - r.top}px`);
      name.classList.add('is-lit');
    });
    name.addEventListener('pointerleave', () => name.classList.remove('is-lit'));
  }
</script>
