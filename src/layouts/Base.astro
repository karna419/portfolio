---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.intro } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.role ? `${site.name} — ${site.role}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#e9f0fb" />
    <!-- Set the theme before first paint so there is no flash of the wrong one. -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        document.querySelector('meta[name="theme-color"]').content = dark ? '#04060d' : '#e9f0fb';
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <!-- The wallpaper stays put; everything else scrolls over it. -->
    <div id="wallpaper" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:top-3 focus:left-3 bg-ink text-paper px-3 py-2 rounded">Skip to content</a>

    <!-- Floating glass bars. The header itself lets clicks through; only the bars catch them. -->
    <header class="fixed top-3 inset-x-0 z-40 pointer-events-none">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 flex items-center justify-between gap-3">
        <!-- The K mark, slanted and drawn like handwriting: a stem in the text colour and a tinted stroke for the arm and leg. Also the tab icon (public/favicon.svg). -->
        <a href="/" aria-label={`${site.name}, home`} title={site.name}
           class="logo glass capsule pointer-events-auto grid place-items-center size-11">
          <svg viewBox="0 0 64 64" class="size-7" fill="none" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M25 13C23.5 25 21 38 17.5 51" stroke="currentColor" />
            <path class="logo-arm" d="M48 14C41 22.5 32 29.5 23 33.5C31 35.5 37.5 42.5 42.5 51.5" stroke="var(--color-tint)" />
          </svg>
        </a>
        <div class="flex items-center gap-2 pointer-events-auto">
          <nav id="tabs" class="glass capsule tabs" aria-label="Sections">
            <span class="lens" aria-hidden="true"></span>
            <a href="/#work" data-tab="work">Work</a>
            <a href="/#about" data-tab="about">About</a>
            <a href="/#contact" data-tab="contact">Let's talk</a>
          </nav>
          <button id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Toggle dark mode"
                  class="glass capsule grid place-items-center size-11 cursor-pointer">
            <!-- Moon in light mode, sun in dark mode. -->
            <svg class="size-[1.15rem] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            <svg class="size-[1.15rem] hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1 pt-20">
      <slot />
    </main>
    <!-- Extra room at the bottom on phones, where the tab bar floats. -->
    <footer class="mx-auto w-full max-w-6xl px-5 sm:px-8 pt-10 pb-28 sm:pb-10 text-sm text-muted">
      © {year} {site.name}. Built with Astro.
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle')!;
      const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!;
      const sync = () => {
        const dark = root.classList.contains('dark');
        toggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        meta.content = dark ? '#04060d' : '#e9f0fb';
      };
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const setTheme = (dark: boolean) => {
        const apply = () => { root.classList.toggle('dark', dark); sync(); };
        // Where the browser can, the whole page cross-fades between light and dark in one go.
        if (!calm && 'startViewTransition' in document) return void document.startViewTransition(apply);
        root.classList.add('theme-switching');
        apply();
        setTimeout(() => root.classList.remove('theme-switching'), 300);
      };
      sync();
      toggle.addEventListener('click', () => {
        const dark = !root.classList.contains('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
        setTheme(dark);
      });
      // Follow the system setting until the visitor picks one themselves.
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) setTheme(e.matches);
      });

      // Glass: the highlight on a pane follows the pointer across it (see .glass in global.css).
      addEventListener('pointermove', (e) => {
        const pane = (e.target as Element | null)?.closest<HTMLElement>('.glass');
        if (!pane) return;
        const r = pane.getBoundingClientRect();
        pane.style.setProperty('--mx', `${e.clientX - r.left}px`);
        pane.style.setProperty('--my', `${e.clientY - r.top}px`);
      }, { passive: true });

      // Tab bar: the lens slides to the tab for whichever section is on screen.
      const tabs = document.getElementById('tabs')!;
      const lens = tabs.querySelector<HTMLElement>('.lens')!;
      const links = [...tabs.querySelectorAll<HTMLAnchorElement>('a[data-tab]')];
      let active: string | null = null;
      const place = () => {
        const link = links.find((a) => a.dataset.tab === active);
        links.forEach((a) => (a === link ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
        if (!link) return void (lens.style.opacity = '0');
        lens.style.translate = `${link.offsetLeft}px 0`;
        lens.style.width = `${link.offsetWidth}px`;
        lens.style.opacity = '1';
      };
      const setActive = (name: string | null) => { active = name; place(); };
      addEventListener('resize', place);

      const sections = links
        .map((a) => document.getElementById(a.dataset.tab!))
        .filter((el): el is HTMLElement => !!el);
      if (sections.length) {
        // A section is "on screen" while it covers the middle line of the viewport.
        const seen = new Set<string>();
        const watcher = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) seen.add(entry.target.id);
            else seen.delete(entry.target.id);
          }
          setActive(sections.find((s) => seen.has(s.id))?.id ?? null);
        }, { rootMargin: '-45% 0px -50% 0px' });
        sections.forEach((s) => watcher.observe(s));
      } else if (location.pathname.startsWith('/work/')) {
        // On a case study, Work is where you are.
        setActive('work');
      }

      // Tapping a project sends its icon travelling to the case-study page (see @view-transition
      // in global.css). Only the tapped icon carries the name, since a name must be unique.
      document.addEventListener('click', (e) => {
        const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="/work/"]');
        const icon = link?.querySelector<HTMLElement>('img');
        if (!icon) return;
        document.querySelectorAll<HTMLElement>('[data-vt]').forEach((el) => { el.style.viewTransitionName = ''; delete el.dataset.vt; });
        icon.style.viewTransitionName = 'work-icon';
        icon.dataset.vt = '';
      });

      // A booked call makes the wallpaper swell for a moment.
      addEventListener('bg:burst', () => {
        const wall = document.getElementById('wallpaper')!;
        wall.classList.add('is-burst');
        setTimeout(() => wall.classList.remove('is-burst'), 1800);
      });
    </script>
  </body>
</html>
