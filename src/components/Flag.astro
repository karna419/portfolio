---
// Small inline flags for the review captions, drawn by hand so the page needs no flag package
// (emoji flags show as plain letters on Windows). Codes are ISO 3166 alpha-2. A code without a
// drawing renders nothing, so add one here before using a new country in src/data/reviews.ts.
interface Props {
  code: string;
  class?: string;
}
const { code, class: cls } = Astro.props;

// Every flag is drawn on a 30×20 canvas.
const flags: Record<string, string> = {
  // United States: 13 stripes, a blue canton with a dotted field of stars.
  US: `
    <rect width="30" height="20" fill="#fff"/>
    ${Array.from({ length: 7 }, (_, i) => `<rect y="${(i * 2 * 20) / 13}" width="30" height="${20 / 13}" fill="#b22234"/>`).join('')}
    <rect width="12" height="${(7 * 20) / 13}" fill="#3c3b6e"/>
    ${Array.from({ length: 4 }, (_, r) =>
      Array.from({ length: 5 }, (_, c) => `<circle cx="${1.3 + c * 2.35 + (r % 2) * 1.1}" cy="${1.4 + r * 2.5}" r="0.45" fill="#fff"/>`).join(''),
    ).join('')}
  `,
  // India: saffron, white and green bands with the navy Ashoka Chakra.
  IN: `
    <rect width="30" height="20" fill="#fff"/>
    <rect width="30" height="6.67" fill="#ff9933"/>
    <rect y="13.33" width="30" height="6.67" fill="#138808"/>
    <circle cx="15" cy="10" r="2.6" fill="none" stroke="#000080" stroke-width="0.6"/>
    <circle cx="15" cy="10" r="0.55" fill="#000080"/>
  `,
  // Kenya: black, red and green bands split by white, with the Maasai shield in the middle.
  KE: `
    <rect width="30" height="20" fill="#fff"/>
    <rect width="30" height="6" fill="#000"/>
    <rect y="7" width="30" height="6" fill="#be0000"/>
    <rect y="14" width="30" height="6" fill="#006600"/>
    <ellipse cx="15" cy="10" rx="2.6" ry="5.6" fill="#be0000" stroke="#000" stroke-width="0.5"/>
    <ellipse cx="15" cy="10" rx="1.1" ry="5.6" fill="#000"/>
    <ellipse cx="15" cy="10" rx="0.55" ry="1.4" fill="#fff"/>
  `,
};
const art = flags[code.toUpperCase()];
---
{art && (
  <svg viewBox="0 0 30 20" class:list={['inline-block shrink-0 rounded-[2px] shadow-[0_0_0_0.5px_rgb(0_0_0/0.25)]', cls]} aria-hidden="true" set:html={art} />
)}
